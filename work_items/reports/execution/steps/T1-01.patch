+class ArtifactKind(str, Enum):
+    FILE = "file"
+    JIT_SOURCE = "jit_source"
+    BUILTIN = "builtin"
+
+
+class ArtifactFormat(str, Enum):
+    ASCENDC_OBJECT = "ascendc_object"
+    SHARED_LIBRARY = "shared_library"
+    ASCENDC_SOURCE = "ascendc_source"
+    ACLNN_BUILTIN = "aclnn_builtin"
