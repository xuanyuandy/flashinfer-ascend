+class CPrimitive(str, Enum):
+    U8 = "u8"
+    U16 = "u16"
+    U32 = "u32"
+    U64 = "u64"
+    I8 = "i8"
+    I16 = "i16"
+    I32 = "i32"
+    I64 = "i64"
+    F32 = "f32"
+    F64 = "f64"
+
+    @property
+    def struct_format(self):
+        return {"u8": "B", "u16": "H", "u32": "I", "u64": "Q",
+                "i8": "b", "i16": "h", "i32": "i", "i64": "q",
+                "f32": "f", "f64": "d"}[self.value]
+
+    @property
+    def size_bytes(self):
+        return struct.calcsize("<" + self.struct_format)
+
