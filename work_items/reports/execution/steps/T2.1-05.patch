--- a/work_items/scripts/check_sampling_signatures.py
+++ b/work_items/scripts/check_sampling_signatures.py
@@ -0,0 +1,23 @@
+"""Check all ten declarations against the fixed upstream git object."""
+
+import ast
+from pathlib import Path
+import subprocess
+
+from flashinfer._sampling import OP_NAMES
+
+upstream = subprocess.check_output([
+    "git", "-C", "/home/dy/projects/flashinfer-ori", "show",
+    "2895577720741ddfedff118202c89584996b8875:flashinfer/sampling.py",
+], text=True)
+
+
+def signatures(source):
+    return {n.name: ast.unparse(n.args) for n in ast.parse(source).body
+            if isinstance(n, ast.FunctionDef) and n.name in OP_NAMES}
+
+
+expected = signatures(upstream)
+actual = signatures(Path("flashinfer/sampling.py").read_text())
+assert actual == expected, (expected, actual)
+print("10/10 signatures match pinned upstream (names, order, defaults, annotations)")
--- a/work_items/scripts/merge_parity.py
+++ b/work_items/scripts/merge_parity.py
@@ -0,0 +1,26 @@
+"""Merge a task's reviewed parity entries, preserving earlier working changes."""
+
+import argparse
+import json
+from pathlib import Path
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument("entries", type=Path)
+parser.add_argument("--ledger", default="flashinfer/data/api_parity.json")
+parser.add_argument("--stage-only", action="store_true")
+args = parser.parse_args()
+path = Path(args.ledger)
+raw = (subprocess.check_output(["git", "show", "HEAD:" + str(path)], text=True)
+       if args.stage_only else path.read_text())
+manifest = json.loads(raw)
+entries = {e["upstream"]: e for e in manifest["entries"]}
+for entry in json.loads(args.entries.read_text()):
+    entries[entry["upstream"]] = entry
+manifest["entries"] = list(entries.values())
+data = json.dumps(manifest, ensure_ascii=False, indent=2) + "\n"
+if args.stage_only:
+    blob = subprocess.check_output(["git", "hash-object", "-w", "--stdin"], input=data, text=True).strip()
+    subprocess.run(["git", "update-index", "--cacheinfo", "100644," + blob + "," + str(path)], check=True)
+else:
+    path.write_text(data)
